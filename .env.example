# Copy to .env and fill in. Only GEMINI_API_KEY is required.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional -----------------------------------------------------------------
LOG_LEVEL=INFO

# Models
# VAANI_CHAT_MODEL=gemini-3.8-flash
# VAANI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite   # tried in order if the primary is overloaded/out of quota
# VAANI_EMBEDDING_MODEL=gemini-embedding-001

# RAG
# PERSIST_DIRECTORY=./chroma_db
# VAANI_RAG_TOP_K=3
# VAANI_RAG_MIN_SCORE=0.68
# VAANI_RAG_MARGIN=0.05

# Speech: "whisper" (offline, weak at Kannada on CPU) or "gemini" (accurate Kannada, uses API quota)
# VAANI_ASR_BACKEND=whisper
# Whisper options (English: "base" is fastest, "small" is a good default; Kannada needs the gemini backend)
# VAANI_WHISPER_MODEL=small
# VAANI_WHISPER_DEVICE=cpu
# VAANI_WHISPER_COMPUTE=int8

# Runtime state (mutated orders/appointments, generated audio)
# VAANI_STATE_DIR=./.state

# Frontend -> backend URL
# VAANI_API_URL=http://localhost:8000
